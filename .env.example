# Lab Automation System — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── App Path ────────────────────────────────────────────────────────────────
# Leave blank if files are in website root, or set to /lab-automation for XAMPP
BASE_URL=

# ─── Database (leave blank for local XAMPP defaults) ─────────────────────────
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ─── SMTP / Email Delivery ───────────────────────────────────────────────────
# When SMTP_HOST is empty, emails are written to logs/ for local development.
# To send real emails, configure a real SMTP provider (Gmail, Mailgun, etc.).

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your-app-password
#   SMTP_ENCRYPTION=tls
#
# IMPORTANT: Use a Gmail "App Password", NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account.

MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Lab Automation System
